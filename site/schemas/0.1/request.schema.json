{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxpprotocol.org/schemas/0.1/request.schema.json",
  "title": "VXP 0.1 request",
  "description": "A request as the company returns it: from POST {endpoint}/requests (201, 202), GET {endpoint}/requests/{id}, accept, counter and cancel (spec §8, Endpoints). It carries the internal state, its projections, what authority is missing, the current proposal with its exact terms, the known effects, the cancellation and the result.",
  "type": "object",
  "required": [
    "request_id",
    "operation",
    "state",
    "projections"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]+$"
    },
    "operation": {
      "$ref": "common.schema.json#/$defs/capabilityId"
    },
    "target": {
      "type": "object"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "projections": {
      "type": "object",
      "required": [
        "poppy",
        "a2a"
      ],
      "properties": {
        "poppy": {
          "$ref": "common.schema.json#/$defs/poppyState"
        },
        "a2a": {
          "$ref": "common.schema.json#/$defs/a2aState"
        }
      }
    },
    "authorization": {
      "description": "What to ask the person for (O2): the missing authorization_details and where to ask.",
      "type": "object",
      "required": [
        "error",
        "authorization_details",
        "device_authorization_endpoint",
        "resource"
      ],
      "properties": {
        "error": {
          "const": "authorization_required"
        },
        "authorization_details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/authorizationDetail"
          }
        },
        "device_authorization_endpoint": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "resource": {
          "$ref": "common.schema.json#/$defs/url"
        }
      }
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[A-Za-z0-9_-]+$"
    },
    "proposal": {
      "$ref": "#/$defs/proposal"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/effect"
      }
    },
    "cancellation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "requested_at",
            "status",
            "reversal_promised"
          ],
          "properties": {
            "requested_at": {
              "$ref": "common.schema.json#/$defs/dateTime"
            },
            "status": {
              "type": "string"
            },
            "reversal_promised": {
              "const": false
            }
          }
        }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "proof_url": {
      "$ref": "common.schema.json#/$defs/url"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "authorization_required"
          }
        }
      },
      "then": {
        "required": [
          "authorization"
        ]
      }
    },
    {
      "if": {
        "required": [
          "proposal"
        ]
      },
      "then": {
        "required": [
          "operation_id",
          "effects",
          "cancellation",
          "result",
          "proof_url"
        ]
      }
    }
  ],
  "$defs": {
    "proposal": {
      "description": "One revision with its exact terms (P1, O4). terms carries a fresh vxp_salt of at least 128 bits in each revision (spec §6, Format).",
      "type": "object",
      "required": [
        "id",
        "revision",
        "state",
        "summary",
        "terms",
        "commitment",
        "expires_at",
        "user_approval_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prop_[A-Za-z0-9_-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "terms": {
          "type": "object",
          "required": [
            "vxp_salt"
          ],
          "properties": {
            "vxp_salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,}$"
            }
          }
        },
        "commitment": {
          "$ref": "common.schema.json#/$defs/commitment"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "user_approval_required": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_revisions": {
              "type": "integer",
              "minimum": 1
            },
            "revisions_left": {
              "type": "integer",
              "minimum": 0
            },
            "max_accept_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "accept_attempts_left": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
